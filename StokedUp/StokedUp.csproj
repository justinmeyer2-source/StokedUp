<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>StokedUp</ApplicationTitle>
    <ApplicationId>com.example.stokedup</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
	<AndroidPackageFormats>apk</AndroidPackageFormats>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Resources\AppIcon\stoked_up_icon.PNG" />
    <None Remove="Resources\Images\stoked_up_logo.PNG" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="11.0.10" />
    <PackageReference Include="sqlite-net-pcl" Version="1.11.285" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3.android" Version="2.1.14" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Views\StokpilePage.xaml.cs">
      <DependentUpon>StokpilePage.xaml</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Resources\Styles\" />
  </ItemGroup>
  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\stoked_up_icon.PNG" />
  </ItemGroup>
  <ItemGroup>
    <MauiImage Include="Resources\Images\stoked_up_logo.PNG" />
  </ItemGroup>
  <ItemGroup>
    <MauiXaml Update="Controls\NavigationBar.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
  </ItemGroup>
</Project>
